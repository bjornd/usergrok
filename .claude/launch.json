{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "usergrok-app",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "app/run.py"
      ],
      "port": 8317,
      "autoPort": true
