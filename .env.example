# Copy to .env. Values below match `supabase start` on the shifted ports in supabase/config.toml.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_STUDIO_URL=http://127.0.0.1:54423

# LLM backend is the local, authenticated `claude` CLI (Claude Code) — no API key required.
CLAUDE_MODEL=sonnet
